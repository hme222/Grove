    "lift": "0 1px 2px color-mix(in srgb, var(--grove-night) 35%, transparent), 0 12px 26px color-mix(in srgb, var(--grove-night) 35%, transparent)",
    "dialog": "0 18px 48px color-mix(in srgb, var(--grove-night) 55%, transparent)"
  },
