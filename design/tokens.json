{
  "version": "0.4",
  "color": {
    "night": "#0B0F08",
    "understory": "#172010",
    "forest": "#202D14",
    "canopy": "#2D3B1A",
    "moss": "#3C4D26",
    "well": "#1C2416",
    "fernLine": "#64793F",
    "inputLine": "#4E6232",
    "lime": "#92B44B",
    "root": "#1A2410",
    "sprout": "#C3D98A",
    "cream": "#F4F1E6",
    "sage": "#B7C0A4",
    "lichen": "#A9B09A",
    "sun": "#E8D77A",
    "bloom": "#E57A9C",
    "paper": "#F5F0E8",
    "ink": "#1A1A17"
  },
  "font": {
    "display": "'Cormorant Garamond', Georgia, serif",
    "ui": "'Alegreya Sans', Optima, Candara, sans-serif"
  },
  "radius": {
    "control": 12,
    "small": 14,
    "field": 16,
    "card": 22,
    "phone": 56,
    "phoneScreen": 45,
    "pill": 999
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    104
  ],
  "touchTarget": {
    "min": 44,
    "button": 48
  },
  "motion": {
    "enter": {
      "duration": "1.6s",
      "easing": "cubic-bezier(.22,.61,.36,1)",
      "distance": "10px",
      "blur": "4px"
    },
    "reveal": {
      "duration": "1.6s",
      "easing": "cubic-bezier(.16,.8,.2,1)",
      "distance": "120px"
    },
    "sparkle": {
      "pop": "1s cubic-bezier(.34,1.56,.64,1)",
      "twinkle": {
        "minScale": 0.35,
        "minOpacity": 0.35,
        "durations": [
          "1.8s",
          "2.5s",
          "3.2s"
        ]
      },
      "perScreen": 1
    },
    "lineReveal": {
      "style": "downward wipe, top to bottom; never traced along the path",
      "edgeFade": "14px",
      "easing": "cubic-bezier(.42,.08,.5,.96)",
      "durationLong": "2.2s",
      "durationShort": "1.5s"
    },
    "welcomeSequence": {
      "order": [
        "brand + Welcome to Grove",
        "stars",
        "line 1 wipe",
        "definition",
        "line 2 wipe",
        "photo + rest"
      ],
      "app": "plays once (~9s), tap to skip",
      "landing": "slow loop (~15s, 4s hold, 1.2s fade)"
    }
  },
  "rules": {
    "primaryButton": "Cream on Night for marketing; Lime on Forest in the app; never both on one screen",
    "handDrawn": "One continuous stroke (underline turns into vine), 1.6px lime, round caps",
    "headline": "Cormorant Garamond 500, 28-36px on marketing pages; one headline per screen"
  },
  "handDrawnLine": {
    "color": "#92B44B",
    "shape": "filled tapered outline (thin ends, ~3.5pt max on a 430pt screen)",
    "wobble": false,
    "penTip": false
  },
  "phoneFrame": {
    "use": "marketing only",
    "screen": "430x932pt scaled to 342x741",
    "bezel": "11px",
    "outer": "364x763",
    "outerRadius": "56px",
    "screenRadius": "45px",
    "dynamicIsland": true,
    "sideButtons": true,
    "placement": "peeks from the bottom, cropped by the fold",
    "content": "live text and vectors, never a screenshot"
  },
  "brand": {
    "name": "FloraGrove",
    "nameRules": "One word, capital F and G. 'grove/groves' (lowercase) remain the community groups; the community tab stays 'Grove'.",
    "wordmark": {
      "flora": {
        "font": "Alegreya Sans",
        "weight": 300,
        "scale": 0.9
      },
      "grove": {
        "font": "Cormorant Garamond",
        "weight": 700,
        "scale": 1
      },
      "v": "two leaves: outlined (Flora) + solid (Grove)",
      "leafColorOnDark": "#92B44B",
      "leafColorOnCream": "#3F5A1A",
      "minGroveHeightPx": 16,
      "files": [
        "design/brand/floragrove-wordmark-cream.svg",
        "design/brand/floragrove-wordmark-root.svg"
      ]
    },
    "mark": {
      "description": "the v from the wordmark",
      "appIcon": {
        "background": "#202D14",
        "markScale": 0.74,
        "file": "design/brand/icon-1024.png"
      },
      "smallSizeOutlineWidth": 3.8,
      "outlineWidth": 2.8,
      "files": [
        "design/brand/floragrove-mark-lime.svg",
        "design/brand/floragrove-mark-root.svg",
        "design/brand/favicon.svg"
      ]
    },
    "dont": [
      "recolour leaves",
      "swap outlined/solid leaf",
      "single-weight wordmark",
      "drop shadow",
      "on a photo without a Night/Root panel",
      "mark next to the wordmark"
    ]
  }
}