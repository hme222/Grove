  },
  "keyframes": {
    "petal": {
      "0%": {
        "transform": "translateY(0) rotate(0deg)",
        "opacity": "0"
      },
      "20%": {
        "opacity": "0.9"
      },
      "100%": {
        "transform": "translateY(120px) rotate(220deg)",
        "opacity": "0"
      }
    },
    "popin": {
      "from": {
        "transform": "scale(0.6)",
        "opacity": "0"
      },
      "to": {
        "transform": "scale(1)",
        "opacity": "1"
      }
    }
  },
  "animation": {
    "petal": "petal 1.8s ease-out forwards",
    "popin": "popin 350ms ease-out"
  },
  "letterSpacing": {
    "label": "0.05em",
    "display": "-0.01em"
  },
  "lineHeight": {
    "reading": "1.55"
  },
  "transitionDuration": {
    "settle": "280ms"
  }
